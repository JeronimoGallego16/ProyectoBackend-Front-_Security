{
  "projectType": "webapp",
  "setup": [
    {
      "command": "npm",
      "args": ["ci"],
      "timeoutSeconds": 600
    }
  ],
  "assertions": [
    {
      "name": "angular-production-build",
      "kind": "process",
      "command": "npm",
      "args": ["run", "build"],
      "verificationMethod": "exit-code",
      "expected": "0",
      "timeoutSeconds": 300
    },
    {
      "name": "tests-pass",
      "kind": "process",
      "command": "npm",
      "args": ["test", "--", "--watch=false"],
      "verificationMethod": "test-results",
      "expected": "0",
      "timeoutSeconds": 300
    },
    {
      "name": "login-route-http-200",
      "kind": "http-probe",
      "startCommand": "npm",
      "startArgs": ["run", "start", "--", "--host", "127.0.0.1"],
      "url": "http://127.0.0.1:4200/authentication/login",
      "verificationMethod": "http-status",
      "expected": "200",
      "timeoutSeconds": 120
    }
  ]
}
